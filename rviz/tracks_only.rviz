Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded: []
      Splitter Ratio: 0.5
    Tree Height: 650
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Tracks
Visualization Manager:
  Class: ""
  Displays:
    # -----------------------------------------------------------
    # Grid: solo riferimento spaziale, nessun dato del detector.
    # -----------------------------------------------------------
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true

    # -----------------------------------------------------------
    # Nuvole grezze processate (preprocessing_node) su cui dbscan_detector_node
    # fa poi il clustering — LiDAR + entrambe le camere.
    # -----------------------------------------------------------
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LiDAR Processed
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /onboard_detector_v2/lidar/processed
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 165; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Front Camera Processed
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /onboard_detector_v2/front_camera/depth/processed
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 200; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Back Camera Processed
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /onboard_detector_v2/back_camera/depth/processed
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # -----------------------------------------------------------
    # Punti su cui sono state fatte le detection: la pointcloud PER-OGGETTO
    # (colorata RGB per box, dbscan_detector_node) da cui ogni box fuso/
    # tracciato e' stato effettivamente costruito — non i cloud grezzi
    # LiDAR/camera, ma esattamente i punti clusterizzati in ogni oggetto.
    # -----------------------------------------------------------
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Fused Clusters
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /onboard_detector_v2/dbscan_detector/fused/clusters
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # -----------------------------------------------------------
    # Box dei vari stream di detection PRIMA della fusione (dbscan_detector_node),
    # un namespace per sorgente — attivabili/disattivabili singolarmente dalla
    # lista "Namespaces" di questo display una volta espanso: lidar, front_camera,
    # back_camera (cluster grezzi per sorgente) e front_camera_yolo/back_camera_yolo
    # (box derivate dai leaf YOLO per camera, ancora non fuse). Disabilitato di
    # default per non affollare la vista — attivalo quando serve debuggare.
    # -----------------------------------------------------------
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Per-Source Detection Boxes
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /onboard_detector_v2/dbscan_detector/boxes_markers
      Value: false

    # -----------------------------------------------------------
    # Box FUSE (dbscan_detector_node), dopo la fusione multi-sorgente ma PRIMA
    # del tracking — utile per vedere cosa arriva effettivamente a tracker_node,
    # separatamente dai cluster-punti colorati gia' mostrati sopra. Disabilitato
    # di default.
    # -----------------------------------------------------------
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Fused Boxes (pre-tracking)
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /onboard_detector_v2/dbscan_detector/fused/boxes_markers
      Value: false

    # -----------------------------------------------------------
    # Unica altra visualizzazione dati: i track persistenti (tracker_node).
    # Box neutro (grigio chiaro) per ogni track, colore diverso (arancione)
    # per i track con evidenza semantica (best_class non vuoto), freccia di
    # velocita' solo se dinamico, etichetta id/[classe]/velocita'.
    # -----------------------------------------------------------
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Tracks
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /onboard_detector_v2/tracker/tracks_markers
      Value: true

    # -----------------------------------------------------------
    # YOLO detection 2D (yolo_semantic_seg_detector): box + id ByteTrack
    # sull'immagine, una per camera — l'evidenza 2D che alimenta la
    # classe semantica dei track (voteClass / SEMANTIC DECAY).
    # -----------------------------------------------------------
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: YOLO Track Front Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Transport Hint: compressed
        Value: /yolo_semantic_seg/front_camera/detection_image
      Value: true

    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: YOLO Track Back Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Transport Hint: compressed
        Value: /yolo_semantic_seg/back_camera/detection_image
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1200
  X: 60
  Y: 60
